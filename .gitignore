# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Supabase configuration. Only .env.example is committed.
.env
.env.local*
.env.*.local
*.pem

# Generated SQL bundle for pasting into the Supabase SQL editor
supabase/.generated

# Supabase CLI scratch state. The CLI is only needed to deploy Edge Functions;
# see docs/TWITCH_METADATA.md.
supabase/.temp

# Extension signing key. The public half lives in the manifest; the private
# half never leaves this machine.
.keys

# Demo build output
dist-demo
dist-firefox
dist-site
dist-site-campaigns

# Test Lab build output. The lab is normally RUN, not built - see docs/TEST_LAB.md.
dist-testlab

# Screenshots and reports written by scripts/cdp.mjs during manual layout work.
*.png
!public/icons/*.png
!src/**/*.png
# Brand icon exports above the four the manifests name. Generated by
# `npm run brand:icons` from assets/brand/geometry.mjs, and committed because a
# store listing should not need a build to get a 512.
!assets/brand/icons/*.png
# The Store listing set. Same reasoning as the icons above, and a stronger case:
# these are photographs of LIVE Twitch, so re-running the capture produces a
# different picture rather than the same one. If they are not committed, the set
# the owner uploaded cannot be recovered, compared against, or re-uploaded after
# a listing edit. Assembled by `npm run assets:store`.
!assets/store/current/**/*.png
!assets/store/current/*.png
# The marketing capture set. Same reasoning as the Store set - photographs of
# LIVE Twitch, so a re-run produces a different picture rather than the same
# one - and a stronger one again: these go into paid advertising, where the
# exact image that ran has to stay recoverable. Assembled by
# `npm run capture:marketing`. Deliberately a SEPARATE directory from
# assets/store/current, which holds the approved v0.9 listing set and must not
# be replaced by a marketing run.
!assets/marketing/current/**/*.png
!assets/marketing/current/*.png

# Private-beta archives. Built by `npm run package:beta`, sent by hand, and
# never committed - a release is reproducible from a tag plus the script.
releases

# Firefox E2E seed profiles. Machine-specific paths to profiles holding real
# sessions - never committed. See scripts/firefox-e2e/seeds.example.json.
scripts/firefox-e2e/seeds.local.json
dist-pages
dist-pages-routing
dist-pages-artifact

# Twitch metadata harvested from the production twitch-metadata Edge Function by
# `npm run metadata:harvest`, for the marketing capture to render. Public Twitch
# facts only - no session, no token, no user data - but it is a point-in-time
# snapshot that goes stale in minutes, so it is never committed.
.metadata-harvest.json

# The metadata harvest's browser profile. Holds a real Watchside sign-in on the
# owner's own machine, so `npm run metadata:harvest` asks for OAuth once rather
# than once per run. Never committed; `--fresh` or deleting the directory clears
# it.
.harvest-profile

# Chrome for Testing, downloaded by
#   npx @puppeteer/browsers install chrome@stable --path .browsers
# The capture harness needs a Chromium that still honours --load-extension;
# branded Chrome dropped the switch in M137. A browser binary, never committed.
.browsers
dist-site-markup
