# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# .env.local is gitignored. Never put the Twitch client secret or the Supabase
# service-role key in this file or anywhere else in this repository.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# production = real Supabase backend. demo = local mock data, no network.
VITE_KICKBACK_MODE=production
